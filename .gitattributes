* text=auto whitespace=-blank-at-eof

# Preserve upstream license wording verbatim; some official texts contain
# intentional trailing spaces that must not fail source-tree whitespace gates.
LICENSES/** whitespace=-trailing-space,-blank-at-eof

# Windows launch and installation scripts must retain CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and documentation use stable LF endings.
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.cs text eol=lf

# Binary assets.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.7z binary
*.pdf binary

